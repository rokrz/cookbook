# Onde o caderno guarda as receitas:
#   (vazio)     tudo no aparelho, sem login e funcionando sem internet (versão para publicar)
#   pocketbase  no servidor PocketBase, com login (scripts/deploy.* já usam este modo)
VITE_BACKEND=

# Só para `npm run dev` com VITE_BACKEND=pocketbase: aponta para o PocketBase local.
# Em produção deixe sem valor; o app é servido pelo próprio PocketBase (mesma origem).
VITE_PB_URL=http://127.0.0.1:8090
