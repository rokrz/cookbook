# Trecho para o nginx. Troque PORTA pela porta pública e mantenha os certificados que já usa.
server {
    listen PORTA ssl http2;   # nginx >= 1.25: use "listen PORTA ssl;" + "http2 on;"
    server_name bokerzcraft.duckdns.org;

    # ssl_certificate     /caminho/fullchain.pem;
    # ssl_certificate_key /caminho/privkey.pem;

    client_max_body_size 10M;

    # Painel administrativo só a partir da rede de casa (ajuste a faixa).
    location /_/ {
        allow 192.168.0.0/16;
        allow 127.0.0.1;
        deny all;
        proxy_pass http://127.0.0.1:8090;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location / {
        proxy_pass http://127.0.0.1:8090;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Connection '';
        proxy_buffering off;
        proxy_read_timeout 360s;
    }
}
